// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator prisma {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

generator client {
  provider = "prisma-kysely"
  output   = "../src/generated"
  fileName = "types.ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String   @id @default(uuid())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt
  email                    String
  emailVerified            Boolean  @default(false)
  name                     String?
  image                    String?
  permission               String   @default("USER")
  stripeCustomerId         String?
  lastActiveOrganizationId String?
  isAdmin                  Boolean  @default(false)

  sessions        Session[]
  accounts        Account[]
  members         Member[]
  invitations     Invitation[]
  dispatchedTasks TaskInstance[]
  Task            Task[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Organization {
  id            String         @id
  name          String
  slug          String
  logo          String?
  createdAt     DateTime
  metadata      String?
  members          Member[]
  invitations      Invitation[]
  agents           Agent[]
  tasks            Task[]
  taskInstances    TaskInstance[]
  Recording        Recording[]
  pipelineStages   PipelineStage[]
  twilioConfig     TwilioConfig?
  callDispositions CallDisposition[]
  callLogs         CallLog[]
  leads            Lead[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String?   @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  seats                Int?

  @@map("subscription")
}

model Example {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("example")
}

model Agent {
  id             String   @id @default(uuid())
  name           String
  slug           String
  organizationId String
  phoneNumber    String
  redirectNumber String
  externalId     String
  externalType   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Agent configuration fields
  industry       String?  // pest_control, hvac, roofing, electrical, cleaning_services
  useCase        String?  // customer_support, outbound_sales, scheduling, lead_qualification, answering_service
  website        String?
  mainGoal       String?
  voiceId        String?  // ElevenLabs voice ID
  status         String   @default("active") // active, paused, archived

  // MCP Configuration - allows each agent to have unique credentials
  mcpApiKey      String?  // API key for MCP authentication
  webhookSecret  String?  // Secret for webhook signature verification
  mcpEndpointUrl String?  // Public URL for this agent's MCP endpoint (e.g., ngrok URL)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@unique([mcpApiKey]) // Ensure API keys are unique for lookup
  @@map("agent")
}

model Task {
  id               String   @id @default(uuid())
  name             String
  description      String?
  agentId          String
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  requiredInfo     Json
  dispatcherUserId String?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent         Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  taskInstances TaskInstance[]
  dispatcher    User?          @relation(fields: [dispatcherUserId], references: [id], onDelete: SetNull)

  @@map("task")
}

model PipelineStage {
  id             String   @id @default(uuid())
  organizationId String
  label          String
  color          String   @default("#6B7280")
  sortOrder      Int      @default(0)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskInstances  TaskInstance[]
  leads          Lead[]

  @@map("pipeline_stage")
}

model TaskInstance {
  id             String   @id @default(uuid())
  taskId         String
  status         String   @default("pending")
  requiredInfo   Json
  info           Json
  conversationId String
  callSid        String?
  dispatcherId   String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Lead Classification
  leadType       String?  // "booking" | "non_booking"
  resolutionType String?  // "resolved" | "unresolved"

  // Customer Classification
  customerType   String?  // "new_customer" | "active_customer"

  // Lead Scoring
  leadScore      Int?     // 1-100 quality score
  estimatedValue Float?   // Estimated revenue potential in dollars

  // Cal.com Integration
  calcomBookingId  String?   // Cal.com booking UID
  calcomEventId    Int?      // Cal.com event type ID
  appointmentTime  DateTime? // Scheduled appointment time
  bookingStatus    String?   // "confirmed" | "cancelled" | "rescheduled" | "completed" | "no_show"
  bookingCancelledAt DateTime? // When the booking was cancelled
  bookingCancelReason String?  // Reason for cancellation

  // Tags for filtering (JSON array of strings)
  tags           Json?    // ["human_caller", "urgent", "robo_caller", etc.]

  // Pipeline stage for Kanban view
  pipelineStage    String?  @default("new") // Legacy string-based stage
  pipelineStageId  String?  // FK to dynamic PipelineStage

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dispatcher     User?          @relation(fields: [dispatcherId], references: [id], onDelete: SetNull)
  Organization   Organization?  @relation(fields: [organizationId], references: [id])
  pipelineStageRef PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  Recording      Recording[]

  @@map("task_instance")
}

model TwilioConfig {
  id               String   @id @default(uuid())
  organizationId   String   @unique
  accountSid       String?
  authToken        String?  // Stored encrypted in production
  phoneNumber      String?
  apiKeySid        String?
  apiKeySecret     String?
  twimlAppSid      String?
  autoRecord       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("twilio_config")
}

model CallDisposition {
  id             String   @id @default(uuid())
  organizationId String
  label          String
  color          String?  @default("#6B7280")
  sortOrder      Int      @default(0)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calls        CallLog[]

  @@map("call_disposition")
}

model CallLog {
  id            String    @id @default(uuid())
  organizationId String
  userId        String?
  callSid       String?
  direction     String    // 'inbound' | 'outbound'
  fromNumber    String
  toNumber      String
  status        String    @default("initiated")
  duration      Int       @default(0)
  recordingUrl  String?
  recordingSid  String?
  outcome       String?
  notes         String?
  dispositionId String?
  leadId        String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  disposition  CallDisposition? @relation(fields: [dispositionId], references: [id], onDelete: SetNull)

  @@map("call_log")
}

model Lead {
  id               String    @id @default(uuid())
  organizationId   String
  firstName        String?
  lastName         String?
  email            String?
  phone            String?
  normalizedPhone  String?
  company          String?
  title            String?
  linkedInUrl      String?
  website          String?
  customFields     Json?
  pipelineStageId  String?
  dealValue        Decimal?  @db.Decimal(12, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineStageRef PipelineStage? @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)

  @@map("lead")
}

model Recording {
  id                  String   @id @default(uuid())
  conversationId      String
  callSid             String
  taskInstanceId      String?
  organizationId      String
  callDurationSeconds Int
  cost                Float
  transcriptSummary   String?
  payload             Json
  callQuality         String?  // "productive" | "short_call" | "robocall" | "spam" | "no_conversation"
  callQualityReason   String?  // Explanation for the quality classification
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  taskInstance TaskInstance? @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)

  @@map("recording")
}
