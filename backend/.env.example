# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vaci?schema=public
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vaci

# Redis Configuration
REDIS_URL=redis://localhost:6380

# Logging (BetterStack)
BETTERSTACK_TOKEN=your_betterstack_token
BETTERSTACK_HOST=your_betterstack_host

# Error Tracking (Sentry)
SENTRY_DSN=your_sentry_dsn

# Authentication
JWT_SECRET=your_jwt_secret_at_least_32_characters_long

# Webhooks
WEBHOOK_API_KEY=your_webhook_api_key

# Stripe (Payments)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (Resend)
RESEND_API_KEY=re_xxx

# ElevenLabs (AI Voice)
ELEVEN_LABS_API_KEY=your_eleven_labs_api_key
ELEVEN_LABS_WEBHOOK_KEY=your_eleven_labs_webhook_key
