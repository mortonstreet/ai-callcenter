# Backend environment variables
# Copy to backend/.env.local (or backend/.env) and replace placeholder values.

# Runtime
NODE_ENV=development
DEPLOY_ENV=dev
PORT=8000
TIMEZONE=America/New_York
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=localhost

# Data layer
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/vaci?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/vaci
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vaci
REDIS_URL=redis://localhost:6380

# Auth/Security
BETTER_AUTH_SECRET=replace-with-long-random-secret
JWT_SECRET=replace-with-long-random-secret
WEBHOOK_API_KEY=replace-with-webhook-key
ENCRYPTION_KEY=replace-with-32-byte-minimum-key

# Observability
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
BETTERSTACK_TOKEN=replace-with-betterstack-token
BETTERSTACK_HOST=s123456.eu-nbg-2.betterstackdata.com

# Providers
ELEVEN_LABS_API_KEY=
ELEVEN_LABS_WEBHOOK_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
WORKIZ_API_KEY=
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
CALCOM_API_KEY=

# Optional MCP provider JSON (overrides legacy ELEVEN_LABS_* fields when set)
# MCP_PROVIDERS=[{"name":"ElevenLabs","slug":"elevenlabs","apiKey":"...","webhookKey":"..."}]

# Worker and queue tuning
WORKER_HEALTH_PORT=8081
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_HEARTBEAT_TTL_MS=45000
QUEUE_METRICS_FLUSH_INTERVAL_MS=30000
QUEUE_DEFAULT_CONCURRENCY=5
QUEUE_CAMPAIGN_VOICE_CONCURRENCY=5
QUEUE_CAMPAIGN_SMS_CONCURRENCY=8
QUEUE_CAMPAIGN_EMAIL_CONCURRENCY=8
QUEUE_INTEGRATION_SYNC_CONCURRENCY=4
QUEUE_WEBHOOK_INGEST_CONCURRENCY=12
